# ==============================================================================
# GASTROTORRE — VARIABLES DE ENTORNO (SUPABASE POSTGRESQL 0 €)
# ==============================================================================
# Si estas variables no se configuran, la aplicación funciona de forma automática
# en modo local/fallback sin bloquearse. Para activar la base de datos PostgreSQL
# en la nube, crea tu proyecto gratuito en https://supabase.com y copia aquí las claves:

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Bot Admin Personal (Copiloto IA exclusivo del Superadmin)
TELEGRAM_ADMIN_BOT_TOKEN="your-admin-bot-token-from-botfather"
GEMINI_API_KEY="your-gemini-api-key-from-aistudio.google.com"
